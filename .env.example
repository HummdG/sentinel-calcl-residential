# ─────────────────────────────────────────────────────────────
# Sentinel Calculator — environment configuration
# Copy to .env.local for local dev; set the same vars in Vercel.
# ─────────────────────────────────────────────────────────────

# ── Groq (AI PDF field extraction) ──────────────────────────
# Required for the PDF auto-fill feature. Free key: https://console.groq.com
GROQ_API_KEY=
# Optional overrides (sensible defaults baked in):
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_CHARS=120000

# ── Email report (SMTP / SendGrid) ──────────────────────────
# Required to send the report by email. For SendGrid SMTP use:
#   SMTP_HOST=smtp.sendgrid.net  SMTP_PORT=587  SMTP_USER=apikey  SMTP_PASS=<your-sendgrid-api-key>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
MAIL_FROM=info@hsenergy.co.uk
MAIL_FROM_NAME=HSEnergy
MAIL_SUBJECT=Your Sentinel EMS Savings Report from HSEnergy
# {customer_name} is replaced with the customer's name (or "there" if blank). Use \n for line breaks.
MAIL_BODY=Hi {customer_name},\n\nPlease find attached your personalised Sentinel EMS Savings Report, prepared by HSEnergy following your survey.\n\nThis report shows the projected financial benefit of adding Sentinel EMS to your solar and battery system, based on the figures we discussed.\n\nIf you have any questions, please don't hesitate to get in touch.\n\nKind regards,\nHSEnergy Group Ltd

# ── Client-side upload cap (megabytes) ──────────────────────
NEXT_PUBLIC_MAX_UPLOAD_MB=20

# ── Business constants (optional; code defaults shown) ──────
# Override any of these to retune the model without a code change.
# SENTINEL_PEAK_SHAVING_PER_KWH=47
# SENTINEL_TRADING_PER_KWH=13
# SENTINEL_IEP_FEE=0.20
# SENTINEL_SENTINEL_FEE=0.20
# SENTINEL_SUB=199
# SENTINEL_EXPORT_BASE_STANDARD=0.055     # £/kWh
# SENTINEL_EXPORT_SENTINEL_FLUX=0.22      # £/kWh
# SENTINEL_FLUX_CHARGE_RATE=0.07          # £/kWh
# SENTINEL_TM_STANDARD=1.0
# SENTINEL_TM_DAYNIGHT=1.20
# SENTINEL_TM_FLUX=1.40
# SENTINEL_UM_DAYTIME=0.75
# SENTINEL_UM_BALANCED=1.0
# SENTINEL_UM_EVENING=1.2
# SENTINEL_BILL_UP_STANDARD=0.08
# SENTINEL_BILL_UP_DAYNIGHT=0.14
# SENTINEL_BILL_UP_FLUX=0.17
# 12 comma-separated monthly generation weights (Jan–Dec), should sum to ~1.0
# SENTINEL_MONTHLY_WEIGHTS=0.0348,0.0487,0.0810,0.1052,0.1288,0.1328,0.1335,0.1170,0.0886,0.0626,0.0382,0.0294
